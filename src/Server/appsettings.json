{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Razorpay": {
    "KeyId": "",
    "KeySecret": "",
    "WebhookSecret": ""
  },
  "Authentication": {
    "CookieName": "ggr.auth",
    "SessionLifetimeMinutes": 720
  },
  "Allocation": {
    "TurnaroundBufferMinutes": 60,
    "PaymentHoldMinutes": 15,
    "MaxReservationAttempts": 5,
    "MinPartnerReliabilityScore": 60
  },
  "BookingPolicy": {
    "TimeZoneId": "Asia/Kolkata",
    "Currency": "INR",
    "RentalDayStartHour": 9,
    "MaxRentalDays": 30,
    "MinLeadMinutes": 60,
    "MaxAdvanceDays": 180
  },
  "NotificationWorker": {
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetries": 8
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@gogoarentals.local"
  },
  "Sms": {
    "Provider": "Log"
  },
  "WhatsApp": {
    "Provider": "Log"
  }
}
